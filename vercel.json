{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/arcturians", "destination": "/arcturians/index.html" },
    { "source": "/academy", "destination": "/academy/index.html" },
    { "source": "/signal-archives", "destination": "/signal-archives/index.html" },
    { "source": "/support", "destination": "/support/index.html" },
    { "source": "/academy/arm-framework", "destination": "/academy/arm-framework/index.html" },
    { "source": "/academy/ai-agent-design", "destination": "/academy/ai-agent-design.html" },
    { "source": "/academy/base-network-ops", "destination": "/academy/base-network-ops.html" },
    { "source": "/academy/decentralized-identity", "destination": "/academy/decentralized-identity.html" },
    { "source": "/academy/signal-ops", "destination": "/academy/signal-ops.html" },
    { "source": "/academy/treasury-governance", "destination": "/academy/treasury-governance.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    }
  ]
}
